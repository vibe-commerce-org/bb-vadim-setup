{
  "name": "bb-plugin-russifier",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37"
  },
  "bb": {
    "name": "Русификатор_vibecom",
    "description": "Русский интерфейс bb для селлеров: переводит подписи, меню и подсказки по словарю, не трогая переписку, код и поле ввода. Работает и в мобильном браузере. Язык переключается в настройках плагина или командой в поиске команд.",
    "branding": {
      "icon": "Globe"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract-strings.mjs",
    "coverage": "node scripts/coverage.mjs",
    "check": "node scripts/check-dict.mjs"
  }
}
